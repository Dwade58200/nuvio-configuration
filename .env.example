# Variables d'environnement pour nuvio-configuration
# Copiez ce fichier en .env et remplissez avec vos clés API

# Clé API TMDB (requise pour la génération des backdrops)
# Obtenez-la sur : https://www.themoviedb.org/settings/api
TMDB_API_KEY=votre_cle_tmdb_ici

# Clé API Fanart.tv (optionnelle, améliore la qualité des images)
# Obtenez-la sur : https://fanart.tv/get-an-api-key/
FANART_API_KEY=votre_cle_fanart_ici

# Clé API MDBList.com (optionnelle, pour les sources provider=mdblist)
# Obtenez-la sur : https://mdblist.com/preferences/
MDBLIST_API_KEY=votre_cle_mdblist_ici
