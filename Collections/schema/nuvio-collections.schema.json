{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Nuvio Collections",
  "description": "Structure attendue de Templates/Nuvio-Collections-Dwade58200.json : une liste de groupes, chacun contenant des dossiers avec leurs sources de catalogue.",
  "type": "array",
  "items": { "$ref": "#/definitions/groupe" },

  "definitions": {
    "groupe": {
      "type": "object",
      "required": ["title", "folders"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "folders": {
          "type": "array",
          "items": { "$ref": "#/definitions/dossier" }
        }
      }
    },

    "dossier": {
      "type": "object",
      "required": ["id", "title", "sources"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "sources": {
          "type": "array",
          "items": { "$ref": "#/definitions/source" }
        },
        "catalogSources": { "type": "array" },
        "hideTitle": { "type": "boolean" },
        "tileShape": { "type": "string" },
        "coverEmoji": { "type": "string" },
        "titleLogoUrl": { "type": "string" },
        "coverImageUrl": { "type": "string" },
        "heroBackdropUrl": { "type": "string" },
        "heroVideoUrl": { "type": "string" },
        "focusGifEnabled": { "type": "boolean" },
        "focusGifUrl": { "type": "string" }
      }
    },

    "source": {
      "type": "object",
      "required": ["provider"],
      "properties": {
        "provider": {
          "type": "string",
          "enum": ["tmdb", "addon", "mdblist"]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "provider": { "const": "tmdb" } }
          },
          "then": {
            "required": ["tmdbSourceType", "mediaType"],
            "properties": {
              "tmdbSourceType": {
                "type": "string",
                "enum": ["COLLECTION", "DISCOVER", "DIRECTOR"]
              },
              "mediaType": { "type": "string", "enum": ["MOVIE", "TV"] },
              "tmdbId": { "type": "integer" },
              "filters": { "type": "object" },
              "sortBy": { "type": "string" }
            }
          }
        },
        {
          "if": {
            "properties": { "provider": { "const": "addon" } }
          },
          "then": {
            "required": ["addonId", "catalogId", "type"],
            "properties": {
              "addonId": { "type": "string", "minLength": 1 },
              "catalogId": { "type": "string", "minLength": 1 },
              "type": { "type": "string" },
              "genre": { "type": "string" }
            }
          }
        },
        {
          "if": {
            "properties": { "provider": { "const": "mdblist" } }
          },
          "then": {
            "required": ["catalogId"],
            "properties": {
              "catalogId": { "type": "string", "minLength": 1 }
            }
          }
        }
      ]
    }
  }
}
